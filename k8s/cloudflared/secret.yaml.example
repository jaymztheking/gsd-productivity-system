# The connector token is NOT stored in this repository.
#
# Create the tunnel in the Cloudflare dashboard (Zero Trust -> Networks ->
# Tunnels), then create the Secret from the token it shows you:
#
#   kubectl create namespace cloudflared
#   kubectl -n cloudflared create secret generic cloudflared-token \
#     --from-literal=token=<connector-token>
#
# Run that in a normal terminal rather than pasting the token into a file, so
# it does not end up in shell history shared with an agent or in version
# control. The Deployment reads it via secretKeyRef.
apiVersion: v1
kind: Secret
metadata:
  name: cloudflared-token
  namespace: cloudflared
type: Opaque
stringData:
  token: "<connector-token>"

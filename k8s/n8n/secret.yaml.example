# The n8n-secrets values are NOT stored in this repository. Create the Secret
# directly, in a normal terminal so the values stay out of shared shell history:
#
#   kubectl -n n8n create secret generic n8n-secrets \
#     --from-literal=DB_POSTGRESDB_PASSWORD=<password of the n8n Postgres user> \
#     --from-literal=N8N_ENCRYPTION_KEY=<existing key>
#
# N8N_ENCRYPTION_KEY encrypts every credential stored in the n8n database (the
# GSD API token, webhook header auth, SMTP). It must be the same key the
# database was written with; a new key makes every stored credential unreadable.
apiVersion: v1
kind: Secret
metadata:
  name: n8n-secrets
  namespace: n8n
type: Opaque
stringData:
  DB_POSTGRESDB_PASSWORD: "change-me"
  N8N_ENCRYPTION_KEY: "change-me"

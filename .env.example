# Postgres
POSTGRES_USER=gsd
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=gsd
POSTGRES_PORT=5433

# API — password here must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql+asyncpg://gsd:<change-me>@postgres:5432/gsd
API_PORT=8000

# Shared secret required on every API data endpoint, sent as the
# X-API-Token header. Generate one with:
#   openssl rand -hex 32
# The same value must be set for the UI proxy and both n8n workflows.
API_TOKEN=<generate-me>

# Browser origins allowed to call the API cross-origin. Normally left
# empty: the UI reaches the API through a same-origin proxy, so nothing
# is cross-origin. Set only if a browser on another origin must call it.
CORS_ALLOW_ORIGINS=

# UI
UI_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# n8n
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=<change-me>
N8N_WEBHOOK_URL=http://n8n:5678
# n8n reaches the API using a stored Header Auth credential, not an env
# var: n8n blocks $env access in expressions by default
# (N8N_BLOCK_ENV_ACCESS_IN_NODE). Create the credentials in the n8n UI --
# see "n8n Credentials" in the README.

# Weekly Digest (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_RECIPIENT=

# Rendered at container start by the nginx:alpine entrypoint, which runs
# envsubst over /etc/nginx/templates/*.template. Only the variables listed
# in NGINX_ENVSUBST_FILTER are substituted, so nginx's own $variables
# survive untouched.

server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback — all routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the api container.
    #
    # The API token is attached here, server-side, so it is never delivered
    # to the browser. The UI calls /api/* as same-origin relative paths and
    # has no knowledge of the secret; putting it in frontend code would ship
    # it to anyone who can load the page.
    location /api/ {
        proxy_pass http://api:8000/;
        proxy_set_header X-API-Token "${API_TOKEN}";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
